{
  "name": "yubsub",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {"ghcr.io/devcontainers/features/node:1": {"version": "22"}},
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && pip install -r requirements.txt",
  "forwardPorts": [5000],
  "portsAttributes": {"5000": {"label": "yubsub", "onAutoForward": "openBrowser"}},
  "postAttachCommand": "python app.py"
}